#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
lib="$root/usr/lib"
# WebKit makes LD_LIBRARY_PATH directories visible to sandboxed helpers. Expose the
# read-only usr tree, not the library search directory: the ELF entry points use RPATH.
export LD_LIBRARY_PATH="$root/usr${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$root/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$root/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$lib/gio/modules"
export GDK_PIXBUF_MODULE_FILE="$lib/loaders.cache"
export GST_PLUGIN_SYSTEM_PATH_1_0="$lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$lib/gstreamer-1.0/gst-plugin-scanner"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/filecloud-desktop"
mkdir -p "$cache"
export GST_REGISTRY_1_0="$cache/gstreamer-registry.bin"
export WEBKIT_INJECTED_BUNDLE_PATH="$lib/webkitgtk-6.0/injected-bundle"
# The relocated WebKit helper path is relative to this directory, also inside its sandbox.
cd "$lib"
exec "$lib/filecloud-desktop/filecloud-desktop" "$@"
